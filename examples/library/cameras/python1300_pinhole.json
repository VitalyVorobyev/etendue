{
  "version": 1,
  "id": "python1300_pinhole",
  "name": "Python 1300, 2318.8 px pinhole (the examples' camera)",
  "description": "A calibrated pinhole without physical optics, as the example cells use it.",
  "camera": {
    "params": {
      "projection": {
        "type": "pinhole"
      },
      "distortion": {
        "type": "brown_conrady5",
        "k1": -0.08,
        "k2": 0.02,
        "k3": 0,
        "p1": 0,
        "p2": 0,
        "iters": 8
      },
      "sensor": {
        "type": "identity"
      },
      "intrinsics": {
        "type": "fx_fy_cx_cy_skew",
        "fx": 2318.8,
        "fy": 2318.8,
        "cx": 640,
        "cy": 512,
        "skew": 0
      }
    },
    "resolution": [
      1280,
      1024
    ]
  }
}
