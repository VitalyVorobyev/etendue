{
  "version": 2,
  "id": "stereo_80mm_parallel",
  "name": "Parallel stereo pair, 80 mm baseline",
  "description": "Two cameras 80 mm apart on the rig's x axis, their axes along the rig's +Z and their image rows aligned, as in examples/eye_in_hand_ur5e. Camera 0 is the left one (-x).",
  "rig": {
    "layout": {
      "count": 2,
      "radius_m": 0.04,
      "phase_rad": 3.141592653589793,
      "working_distance_m": 0.5,
      "tilt_rad": 0,
      "image_x": "common",
      "camera": {
        "params": {
          "projection": {
            "type": "pinhole"
          },
          "distortion": {
            "type": "brown_conrady5",
            "k1": -0.08,
            "k2": 0.02,
            "k3": 0,
            "p1": 0,
            "p2": 0,
            "iters": 8
          },
          "sensor": {
            "type": "identity"
          },
          "intrinsics": {
            "fx": 2318.8,
            "fy": 2318.8,
            "cx": 640,
            "cy": 512
          }
        },
        "resolution": [
          1280,
          1024
        ]
      }
    }
  }
}
