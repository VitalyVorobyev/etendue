<?xml version="1.0"?>
<!-- Hand-written 6R test arm (UR-like layout) for etendue-kinematics unit
     tests: a `world` root above the base, rpy joint origins, a continuous
     joint, a fixed tool frame, and an off-chain prismatic finger. -->
<robot name="test_arm">
  <link name="world"/>
  <link name="base_link"/>
  <link name="link1"/>
  <link name="link2"/>
  <link name="link3"/>
  <link name="link4"/>
  <link name="link5"/>
  <link name="link6"/>
  <link name="tool0"/>
  <link name="finger"/>
  <joint name="world_joint" type="fixed">
    <parent link="world"/><child link="base_link"/>
    <origin xyz="0.1 -0.2 0.3" rpy="0 0 0.5"/>
  </joint>
  <joint name="j1" type="revolute">
    <parent link="base_link"/><child link="link1"/>
    <origin xyz="0 0 0.16" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="100" velocity="2.0"/>
  </joint>
  <joint name="j2" type="revolute">
    <parent link="link1"/><child link="link2"/>
    <origin xyz="0 0.13 0" rpy="0 1.5707963267948966 0"/><axis xyz="0 1 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="100" velocity="2.0"/>
  </joint>
  <joint name="j3" type="revolute">
    <parent link="link2"/><child link="link3"/>
    <origin xyz="0 -0.12 0.42" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="100" velocity="2.0"/>
  </joint>
  <joint name="j4" type="continuous">
    <parent link="link3"/><child link="link4"/>
    <origin xyz="0 0 0.39" rpy="0 1.5707963267948966 0"/><axis xyz="0 1 0"/>
  </joint>
  <joint name="j5" type="revolute">
    <parent link="link4"/><child link="link5"/>
    <origin xyz="0 0.09 0" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="100" velocity="3.0"/>
  </joint>
  <joint name="j6" type="revolute">
    <parent link="link5"/><child link="link6"/>
    <origin xyz="0 0 0.09" rpy="0.1 -0.2 0.3"/><axis xyz="0 1 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="100" velocity="3.0"/>
  </joint>
  <joint name="tool_joint" type="fixed">
    <parent link="link6"/><child link="tool0"/>
    <origin xyz="0 0.08 0" rpy="-1.5707963267948966 0 0"/>
  </joint>
  <joint name="finger_joint" type="prismatic">
    <parent link="tool0"/><child link="finger"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="0" upper="0.04" effort="10" velocity="0.1"/>
  </joint>
</robot>
