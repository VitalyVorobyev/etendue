{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CaptureExport",
  "description": "The pose sequence of one robot: its tool pose and joints at every\ncapture, version 1.",
  "type": "object",
  "properties": {
    "base_link": {
      "description": "The frame tool poses are given in (the manifest's `base_link`).",
      "type": "string"
    },
    "captures": {
      "description": "One entry per capture, in time order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/CaptureRow"
      }
    },
    "joint_names": {
      "description": "Joint names, in `q` order.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "robot": {
      "description": "Robot id.",
      "type": "string"
    },
    "tcp_link": {
      "description": "The tool frame (the manifest's `tcp_link`).",
      "type": "string"
    },
    "version": {
      "description": "Format version; `1`.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "robot",
    "base_link",
    "tcp_link",
    "joint_names",
    "captures"
  ],
  "$defs": {
    "CaptureRow": {
      "description": "One capture.",
      "type": "object",
      "properties": {
        "base_se3_tool": {
          "description": "Tool pose in the robot's base frame.",
          "$ref": "#/$defs/Iso3Schema"
        },
        "capture": {
          "description": "Capture id.",
          "type": "string"
        },
        "q": {
          "description": "Joint positions (rad or m).",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "t": {
          "description": "Time, seconds.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "capture",
        "t",
        "base_se3_tool",
        "q"
      ]
    },
    "Iso3Schema": {
      "description": "JSON Schema proxy for [`Iso3`] (`nalgebra::Isometry3<f64>`).\n\n`nalgebra` does not implement [`schemars::JsonSchema`], so `*Export` and\nparameter types that embed [`Iso3`] annotate the field with\n`#[cfg_attr(feature = \"schemars\", schemars(with = \"Iso3Schema\"))]`\n(or `Vec<Iso3Schema>` / `Option<Iso3Schema>`). This proxy mirrors the exact\nserde wire format of `Isometry3`:\n`{ \"rotation\": [qx, qy, qz, qw], \"translation\": [tx, ty, tz] }`.\n\nIt exists only to describe that shape to `schemars`; it is never\nconstructed at runtime.",
      "type": "object",
      "properties": {
        "rotation": {
          "description": "Unit quaternion `[qx, qy, qz, qw]` (i, j, k, w order).",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 4,
          "minItems": 4
        },
        "translation": {
          "description": "Translation `[tx, ty, tz]` in meters.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 3,
          "minItems": 3
        }
      },
      "required": [
        "rotation",
        "translation"
      ]
    }
  }
}
