{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MotionReport",
  "description": "Feasibility of every step of a scenario, version 1.",
  "type": "object",
  "properties": {
    "captures": {
      "description": "Number of captures.",
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "duration_s": {
      "description": "Total duration, seconds.",
      "type": "number",
      "format": "double"
    },
    "steps": {
      "description": "One entry per scenario step, in order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/StepReport"
      }
    },
    "version": {
      "description": "Format version; `1`.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "duration_s",
    "captures",
    "steps"
  ],
  "$defs": {
    "Binding": {
      "description": "Which limit binds a step.",
      "type": "object",
      "properties": {
        "fraction": {
          "description": "Its peak as a fraction of the limit.",
          "type": "number",
          "format": "double"
        },
        "joint": {
          "description": "Joint name.",
          "type": "string"
        },
        "quantity": {
          "description": "The limited quantity.",
          "$ref": "#/$defs/Quantity"
        }
      },
      "additionalProperties": false,
      "required": [
        "joint",
        "quantity",
        "fraction"
      ]
    },
    "IkReport": {
      "description": "How a `ptp_pose` step's configuration was found.",
      "oneOf": [
        {
          "description": "The step's own `q` (checked to reach the pose).",
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "const": "stored"
            }
          },
          "additionalProperties": false,
          "required": [
            "source"
          ]
        },
        {
          "description": "Inverse kinematics from the robot's configuration before the step.",
          "type": "object",
          "properties": {
            "attempt": {
              "description": "`0`: converged from the current configuration; `k`: on restart\n`k`, from a seed elsewhere in the joint space — likely another IK\nbranch, so the arm may swing far.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "iterations": {
              "description": "Iterations, all attempts.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "source": {
              "type": "string",
              "const": "solved"
            }
          },
          "additionalProperties": false,
          "required": [
            "source",
            "attempt",
            "iterations"
          ]
        }
      ]
    },
    "JointPeak": {
      "description": "Peak use of one joint's limits over a step, as fractions of the limits\n(`1` = at the limit; `speed_scale` keeps them at or below it).",
      "type": "object",
      "properties": {
        "acceleration": {
          "description": "max |q̈| / acceleration limit.",
          "type": "number",
          "format": "double"
        },
        "jerk": {
          "description": "max |q⃛| / jerk limit, if the joint has one.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "joint": {
          "description": "Joint name.",
          "type": "string"
        },
        "velocity": {
          "description": "max |q̇| / velocity limit.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "joint",
        "velocity",
        "acceleration"
      ]
    },
    "MotionWarning": {
      "description": "Something about a step that deserves a look, tagged on `type`.",
      "oneOf": [
        {
          "description": "IK converged only from a restart seed: the configuration may be on\nanother branch than the robot's current one. Store `q` (resolve the\nscenario) to pin the branch.",
          "type": "object",
          "properties": {
            "attempt": {
              "description": "The restart that converged.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "ik_restart_used"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "attempt"
          ]
        },
        {
          "description": "A joint comes within `margin` of a position limit.",
          "type": "object",
          "properties": {
            "joint": {
              "description": "Joint name.",
              "type": "string"
            },
            "margin": {
              "description": "Its smallest distance from a limit (rad or m).",
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "near_limit"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "joint",
            "margin"
          ]
        },
        {
          "description": "The TCP Jacobian's smallest singular value drops below the\nthreshold: the arm passes near a singularity.",
          "type": "object",
          "properties": {
            "sigma": {
              "description": "The smallest singular value.",
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "near_singular"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "sigma"
          ]
        },
        {
          "description": "A `lin` move's joints change fast between waypoints.",
          "type": "object",
          "properties": {
            "jump": {
              "description": "The largest change (rad or m).",
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "large_joint_jump"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "jump"
          ]
        }
      ]
    },
    "Quantity": {
      "description": "A joint quantity with a limit.",
      "oneOf": [
        {
          "description": "Joint speed.",
          "type": "string",
          "const": "velocity"
        },
        {
          "description": "Joint acceleration.",
          "type": "string",
          "const": "acceleration"
        },
        {
          "description": "Joint jerk.",
          "type": "string",
          "const": "jerk"
        }
      ]
    },
    "StepReport": {
      "description": "One step of the program.",
      "type": "object",
      "properties": {
        "binding": {
          "description": "The joint and quantity closest to its limit: what sets the step's\nduration.",
          "anyOf": [
            {
              "$ref": "#/$defs/Binding"
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_s": {
          "description": "Duration, seconds (`0` for a motion that does not move).",
          "type": "number",
          "format": "double"
        },
        "ik": {
          "description": "How a `ptp_pose` found its joint configuration.",
          "anyOf": [
            {
              "$ref": "#/$defs/IkReport"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "description": "The step's `type` (`ptp_joints`, `ptp_pose`, `lin`, `capture`, `wait`).",
          "type": "string"
        },
        "max_joint_jump": {
          "description": "For a `lin`: the largest joint change between consecutive IK\nwaypoints (rad or m).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "min_limit_margin": {
          "description": "Smallest distance of any joint from its position limits over the\nstep (rad or m).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "min_sigma": {
          "description": "Smallest singular value of the 6×n TCP Jacobian over the step\n(translation rows in m/rad, rotation rows in rad/rad): near zero at\na singularity.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "peaks": {
          "description": "Per joint of the moving robot: the largest |velocity|, |acceleration|\nand |jerk| over the step as fractions of the joint's limits.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/JointPeak"
          }
        },
        "robot": {
          "description": "The robot it moves, for a motion.",
          "type": [
            "string",
            "null"
          ]
        },
        "step": {
          "description": "Index into the scenario's `steps`.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "t0": {
          "description": "Start time, seconds.",
          "type": "number",
          "format": "double"
        },
        "warnings": {
          "description": "What deserves a look.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/MotionWarning"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "step",
        "kind",
        "t0",
        "duration_s"
      ]
    }
  }
}
