{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScenarioSpec",
  "description": "A motion scenario, version 1.",
  "type": "object",
  "properties": {
    "description": {
      "description": "Free-text description.",
      "type": [
        "string",
        "null"
      ]
    },
    "dt": {
      "description": "Baking sample period in seconds, `> 0`.",
      "type": "number",
      "format": "double"
    },
    "generator": {
      "description": "The generator the steps were made by, kept so it can be edited and\nrun again; the steps are the source of truth.",
      "anyOf": [
        {
          "$ref": "#/$defs/GeneratorSpec"
        },
        {
          "type": "null"
        }
      ]
    },
    "steps": {
      "description": "The program, executed in order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Step"
      }
    },
    "version": {
      "description": "Format version; must be `1`.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "dt",
    "steps"
  ],
  "$defs": {
    "AngleSteps": {
      "description": "`steps` angles from `min_rad` to `max_rad`, both included (a full turn\ncounts its start once).",
      "type": "object",
      "properties": {
        "max_rad": {
          "description": "Last angle, radians.",
          "type": "number",
          "format": "double"
        },
        "min_rad": {
          "description": "First angle, radians.",
          "type": "number",
          "format": "double"
        },
        "steps": {
          "description": "Number of angles, ≥ 1.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "min_rad",
        "max_rad",
        "steps"
      ]
    },
    "GeneratorSpec": {
      "description": "How a scenario's poses were generated, tagged on `type`.",
      "oneOf": [
        {
          "description": "Poses on spheres around the target, the sensor looking at the centre.",
          "type": "object",
          "properties": {
            "centre_m": {
              "description": "Sphere centre in the target frame, metres; default the target's\ncentre (a PuzzlePole's axis midpoint).",
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "number",
                "format": "double"
              },
              "maxItems": 3,
              "minItems": 3
            },
            "joint_margin_rad": {
              "description": "Smallest distance of any joint from its limits (rad or m).",
              "type": "number",
              "format": "double",
              "default": 0.05
            },
            "look": {
              "description": "The sensor frame: a rig, a camera, or any frame rigidly carried by\nthe robot's tool.",
              "type": "string"
            },
            "look_se3_sensor": {
              "description": "The sensor axis relative to `look` (identity by default).",
              "anyOf": [
                {
                  "$ref": "#/$defs/Iso3Schema"
                },
                {
                  "type": "null"
                }
              ]
            },
            "min_sigma": {
              "description": "Smallest singular value of the tool Jacobian.",
              "type": "number",
              "format": "double",
              "default": 0.02
            },
            "phi": {
              "description": "Azimuths about the pole.",
              "$ref": "#/$defs/AngleSteps"
            },
            "pole": {
              "description": "The sphere's pole (θ = 0) in the target frame; default +Z, the\nboard's normal (for a PuzzlePole, +X, the seam's outward normal).",
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "number",
                "format": "double"
              },
              "maxItems": 3,
              "minItems": 3
            },
            "radii_m": {
              "description": "Sphere radii, metres.",
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              }
            },
            "require": {
              "description": "Which cameras must see the target, and how much of it.",
              "$ref": "#/$defs/Visibility",
              "default": {
                "margin_px": 2.0,
                "min_visible_fraction": 1.0
              }
            },
            "return_home": {
              "description": "Go back to the start configuration at the end.",
              "type": "boolean",
              "default": false
            },
            "robot": {
              "description": "The robot that carries the sensor.",
              "type": "string"
            },
            "roll_rad": {
              "description": "Rolls of the sensor about its axis, radians (default `[0]`).",
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              }
            },
            "speed_scale": {
              "description": "Fraction of the joint limits the moves use, in `(0, 1]`.",
              "type": "number",
              "format": "double",
              "default": 0.5
            },
            "target": {
              "description": "The target looked at.",
              "type": "string"
            },
            "theta": {
              "description": "Polar angles from the pole.",
              "$ref": "#/$defs/AngleSteps"
            },
            "type": {
              "type": "string",
              "const": "sphere"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "robot",
            "look",
            "target",
            "radii_m",
            "theta",
            "phi"
          ]
        }
      ]
    },
    "Iso3Schema": {
      "description": "JSON Schema proxy for [`Iso3`] (`nalgebra::Isometry3<f64>`).\n\n`nalgebra` does not implement [`schemars::JsonSchema`], so `*Export` and\nparameter types that embed [`Iso3`] annotate the field with\n`#[cfg_attr(feature = \"schemars\", schemars(with = \"Iso3Schema\"))]`\n(or `Vec<Iso3Schema>` / `Option<Iso3Schema>`). This proxy mirrors the exact\nserde wire format of `Isometry3`:\n`{ \"rotation\": [qx, qy, qz, qw], \"translation\": [tx, ty, tz] }`.\n\nIt exists only to describe that shape to `schemars`; it is never\nconstructed at runtime.",
      "type": "object",
      "properties": {
        "rotation": {
          "description": "Unit quaternion `[qx, qy, qz, qw]` (i, j, k, w order).",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 4,
          "minItems": 4
        },
        "translation": {
          "description": "Translation `[tx, ty, tz]` in meters.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 3,
          "minItems": 3
        }
      },
      "required": [
        "rotation",
        "translation"
      ]
    },
    "Step": {
      "description": "One scenario step, tagged on `type`.",
      "oneOf": [
        {
          "description": "Point-to-point move to a joint configuration: straight in joint space,\nevery joint on one synchronised jerk-limited profile (Ruckig;\ntrapezoidal when no moving joint has a jerk limit).",
          "type": "object",
          "properties": {
            "q": {
              "description": "Target joint positions, manifest joint order.",
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              }
            },
            "robot": {
              "description": "Robot id.",
              "type": "string"
            },
            "speed_scale": {
              "description": "Fraction of the joint velocity, acceleration and jerk limits, in\n`(0, 1]`.",
              "type": "number",
              "format": "double",
              "default": 1.0
            },
            "type": {
              "type": "string",
              "const": "ptp_joints"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "robot",
            "q"
          ]
        },
        {
          "description": "Point-to-point move to a tool pose (inverse kinematics from the\ncurrent configuration, then as [`Step::PtpJoints`]).",
          "type": "object",
          "properties": {
            "base_se3_tool": {
              "description": "Target pose of the TCP link in the robot base frame.",
              "$ref": "#/$defs/Iso3Schema"
            },
            "q": {
              "description": "The joint configuration that reaches `base_se3_tool`, when it has\nbeen chosen (a pose generator, `resolve`): the move then goes\nthere without inverse kinematics, so baking can never switch to\nanother IK branch. It must reach the pose (checked when the\nscenario is compiled).",
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "number",
                "format": "double"
              }
            },
            "robot": {
              "description": "Robot id.",
              "type": "string"
            },
            "speed_scale": {
              "description": "Fraction of the joint velocity, acceleration and jerk limits, in\n`(0, 1]`.",
              "type": "number",
              "format": "double",
              "default": 1.0
            },
            "type": {
              "type": "string",
              "const": "ptp_pose"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "robot",
            "base_se3_tool"
          ]
        },
        {
          "description": "Straight-line Cartesian move of the TCP (translation linear, rotation\nslerp), time-scaled so no joint limit is exceeded.",
          "type": "object",
          "properties": {
            "base_se3_tool": {
              "description": "Target pose of the TCP link in the robot base frame.",
              "$ref": "#/$defs/Iso3Schema"
            },
            "robot": {
              "description": "Robot id.",
              "type": "string"
            },
            "speed_scale": {
              "description": "Fraction of the joint velocity, acceleration and jerk limits, in\n`(0, 1]`.",
              "type": "number",
              "format": "double",
              "default": 1.0
            },
            "type": {
              "type": "string",
              "const": "lin"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "robot",
            "base_se3_tool"
          ]
        },
        {
          "description": "Take one image with every camera: one stationary sample, flagged.",
          "type": "object",
          "properties": {
            "id": {
              "description": "Capture id; defaults to `cap_NNN` (running index over captures).",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "capture"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "description": "Hold still.",
          "type": "object",
          "properties": {
            "duration_s": {
              "description": "Duration in seconds, `≥ 0`.",
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "wait"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "duration_s"
          ]
        }
      ]
    },
    "Visibility": {
      "description": "Which cameras must see the target.",
      "type": "object",
      "properties": {
        "cameras": {
          "description": "The cameras; all of the scene's when absent.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "margin_px": {
          "description": "Image border margin, pixels.",
          "type": "number",
          "format": "double",
          "default": 2.0
        },
        "min_visible_fraction": {
          "description": "Fraction of the target's points each must see, in `(0, 1]`.",
          "type": "number",
          "format": "double",
          "default": 1.0
        }
      },
      "additionalProperties": false
    }
  }
}
