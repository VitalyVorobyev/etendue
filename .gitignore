# Build artifacts
/target

# wasm-pack output for etendue-wasm (npm package staging dir)
crates/etendue-wasm/pkg/

# This workspace ships a binary (etendue-ui), so Cargo.lock IS committed.
# Do not add Cargo.lock here.

# mdBook build output (book/ sources are committed; book/book/ is generated)
book/book/

# Editor / OS noise
*.swp
.DS_Store

# Robot assets (tools/robot-assets/build.py). Converted meshes are NOT committed,
# even where the upstream licence permits redistribution (ur5e, abb_irb1200_5_90:
# see license.meshes_redistributable in robot.json): they are ~12 MB and rebuild
# byte-identically from the pinned upstream SHAs. robot.urdf, robot.json and
# LICENSE are committed.
assets/robots/*/meshes/
# Local state of the robot asset pipeline (uv venv, pinned upstream checkouts)
tools/robot-assets/.venv/
# The closed-loop tool's uv venv
tools/closed-loop/.venv/
tools/closed-loop/__pycache__/
tools/robot-assets/.cache/

# web/ (bun workspace): dependencies, builds, test output
web/node_modules/
web/**/node_modules/
web/**/dist/
web/**/coverage/
web/**/.vitest/
web/**/test-results/
web/**/playwright-report/

# Python bytecode (Blender script tests)
__pycache__/
