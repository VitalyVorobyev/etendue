{
  "name": "@vitavision/three-react",
  "version": "0.0.0",
  "private": true,
  "description": "React Three Fiber components over @vitavision/three. Incubating in etendue; moves to lab-ui (L8-1).",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "src", "!src/**/*.test.*", "!src/**/*.stories.*"],
  "exports": {
    ".": {
      "@vitavision/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@react-three/fiber": "^9.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.0"
  },
  "dependencies": {
    "@vitavision/three": "workspace:*"
  },
  "devDependencies": {
    "@react-three/fiber": "9.8.1",
    "@types/three": "0.186.0",
    "three": "0.186.1"
  }
}
