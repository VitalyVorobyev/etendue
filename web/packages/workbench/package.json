{
  "name": "@vitavision/workbench",
  "version": "0.0.0",
  "private": true,
  "description": "Studio-app building blocks on @vitavision/ui: app shell, split panes, tree view, playback bar, file drop, toasts. Incubating in etendue; moves to lab-ui.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "sideEffects": ["*.css"],
  "files": ["dist", "src", "!src/**/*.test.*", "!src/**/*.stories.*"],
  "exports": {
    ".": {
      "@vitavision/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@vitavision/ui": "^0.6.0",
    "lucide-react": "^1.48.0"
  }
}
