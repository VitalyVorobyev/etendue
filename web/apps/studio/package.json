{
  "name": "@etendue/studio",
  "private": true,
  "type": "module",
  "description": "etendue studio: load a scene and scenario, bake them with @etendue/wasm, and play them back in 3D (docs/pivot/PLAN.md P2-5). Not published.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:perf": "playwright test --config playwright.perf.config.ts"
  },
  "dependencies": {
    "@etendue/wasm": "workspace:*",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@react-three/fiber": "9.8.1",
    "@vitavision/charts": "^0.6.0",
    "@vitavision/stage2d": "^0.6.0",
    "@vitavision/three": "workspace:*",
    "@vitavision/three-react": "workspace:*",
    "@vitavision/ui": "^0.6.0",
    "@vitavision/ui-next": "workspace:*",
    "@vitavision/workbench": "workspace:*",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.3",
    "@types/three": "0.186.0",
    "@vitavision/chess-corners": "1.2.0"
  }
}
