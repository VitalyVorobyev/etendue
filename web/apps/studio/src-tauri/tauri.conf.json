{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "etendue studio",
  "version": "0.1.0",
  "mainBinaryName": "etendue-studio",
  "identifier": "com.vitalyvorobyev.etendue-studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5178",
    "beforeDevCommand": {
      "script": "bun run dev",
      "cwd": ".."
    },
    "beforeBuildCommand": {
      "script": "bun run build",
      "cwd": ".."
    }
  },
  "app": {
    "windows": [
      {
        "title": "etendue studio",
        "label": "main",
        "width": 1600,
        "height": 1000,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
