{
  "name": "@etendue/web",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "apps/*",
    "../crates/etendue-wasm/pkg"
  ],
  "scripts": {
    "wasm": "node ../crates/etendue-wasm/scripts/build-npm.mjs",
    "generate:types": "bun scripts/generate-wasm-types.ts",
    "generate:types:check": "bun scripts/generate-wasm-types.ts --check",
    "check:deps": "bun scripts/check-deps.ts",
    "build": "bun run --filter './packages/*' build && bun run --filter './apps/*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "lint": "eslint .",
    "dev": "bun run --filter @etendue/studio dev"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitavision/config-eslint": "^0.1.0",
    "@vitavision/config-ts": "^0.1.0",
    "@vitavision/config-vitest": "^0.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "5.0.2",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "^10.11.0",
    "happy-dom": "^20.11.1",
    "json-schema-to-typescript": "^15.0.4",
    "playwright": "1.63.0",
    "prettier": "^3.9.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.3",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
