{
  "name": "@etendue/web",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "../crates/etendue-wasm/pkg"
  ],
  "type": "module",
  "scripts": {
    "wasm": "node ../crates/etendue-wasm/scripts/build-npm.mjs",
    "generate:types": "bun scripts/generate-wasm-types.ts",
    "generate:types:check": "bun scripts/generate-wasm-types.ts --check",
    "check:deps": "bun scripts/check-deps.ts",
    "build": "bun run --filter './apps/*' build",
    "typecheck": "tsc -p tsconfig.json && bun run --filter '*' typecheck",
    "test": "bun test scripts && bun run --filter '*' test",
    "lint": "oxlint --type-aware --deny-warnings",
    "dev": "bun run --filter @etendue/studio dev",
    "format": "cd .. && oxfmt web crates/etendue-wasm/js crates/etendue-wasm/scripts crates/etendue-wasm/tests",
    "format:check": "bun run format --check"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitavision/config-ts": "^0.1.1",
    "@vitavision/config-vitest": "^0.4.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "5.0.2",
    "@vitest/coverage-v8": "5.0.2",
    "happy-dom": "^20.11.1",
    "json-schema-to-typescript": "^15.0.4",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "playwright": "1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "bun@1.4.2"
}
